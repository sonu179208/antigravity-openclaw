[Unit]
Description=Antigravity OpenAI Bridge Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env node /path/to/antigravity-bridge.mjs
Restart=always
RestartSec=3
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
